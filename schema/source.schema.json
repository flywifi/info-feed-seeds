{
  "$defs": {
    "route": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "description": "Adapter module name under feeder/adapters that reads this route.",
          "enum": [
            "feed",
            "page",
            "sitemap",
            "json-api",
            "urllist"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "page",
            "rss",
            "atom",
            "rdf",
            "jsonfeed",
            "sitemap",
            "json-api",
            "urllist"
          ],
          "type": "string"
        },
        "params": {
          "description": "Adapter parameters, for example a JSON path or a CSS selector. Public values only.",
          "type": "object"
        },
        "url": {
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url",
        "adapter"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/flywifi/info-feed-seeds/schema/source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manifest of one source, stored at sources/<id>/source.json. The id must equal the folder name; hub lint checks that because a schema cannot see the path.",
  "if": {
    "required": [
      "auth"
    ]
  },
  "properties": {
    "added": {
      "description": "Date the source was added, YYYY-MM-DD.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "auth": {
      "additionalProperties": false,
      "description": "Present only for credential-gated sources. Names a credential, never a value, person or company.",
      "properties": {
        "credential": {
          "pattern": "^[a-z][a-z0-9-]{2,40}$",
          "type": "string"
        }
      },
      "required": [
        "credential"
      ],
      "type": "object"
    },
    "authority": {
      "enum": [
        "primary",
        "secondary"
      ],
      "type": "string"
    },
    "classification_review": {
      "description": "pending until a person confirms authority and tier.",
      "enum": [
        "pending",
        "confirmed"
      ],
      "type": "string"
    },
    "discovered_from": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "seed",
            "opml",
            "crawl",
            "autodiscovery",
            "manual"
          ],
          "type": "string"
        },
        "ref": {
          "description": "Seed file path, OPML URL, crawl job id, or the page that linked the feed.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "date"
      ],
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "expected_update_period_days": {
      "description": "How often the publisher is expected to post; a source quiet for longer than this is flagged stale.",
      "minimum": 0,
      "type": "number"
    },
    "homepage": {
      "pattern": "^https?://",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "interval_days": {
      "description": "Minimum days between polls of this source.",
      "minimum": 0,
      "type": "number"
    },
    "label": {
      "minLength": 1,
      "type": "string"
    },
    "lists": {
      "description": "Named lists this source belongs to (for example a profile's source list).",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "publisher": {
      "minLength": 1,
      "type": "string"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1,
      "type": "array"
    },
    "runs_on": {
      "items": {
        "enum": [
          "actions",
          "local"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "tier": {
      "enum": [
        "canonical",
        "news",
        "vendor"
      ],
      "type": "string"
    },
    "topics": {
      "description": "topic or topic/subtopic ids from schema/topics.json.",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "verified": {
      "description": "Date of the last real fetch that parsed at least one item, or null when never proven.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "label",
    "publisher",
    "homepage",
    "routes",
    "topics",
    "authority",
    "tier",
    "classification_review",
    "enabled",
    "added",
    "discovered_from",
    "verified"
  ],
  "then": {
    "description": "A credential-gated source runs only on the local machine.",
    "properties": {
      "runs_on": {
        "items": {
          "const": "local"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "runs_on"
    ]
  },
  "title": "Source manifest",
  "type": "object"
}
