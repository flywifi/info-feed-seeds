{
  "$defs": {
    "route": {
      "additionalProperties": false,
      "else": {
        "else": {
          "else": {
            "else": {
              "else": {
                "else": {
                  "if": {
                    "properties": {
                      "adapter": {
                        "const": "artifact"
                      }
                    },
                    "required": [
                      "adapter"
                    ]
                  },
                  "then": {
                    "properties": {
                      "params": {
                        "additionalProperties": false,
                        "properties": {
                          "label": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    }
                  }
                },
                "if": {
                  "properties": {
                    "adapter": {
                      "const": "urllist"
                    }
                  },
                  "required": [
                    "adapter"
                  ]
                },
                "then": {
                  "properties": {
                    "params": {
                      "additionalProperties": false,
                      "properties": {},
                      "type": "object"
                    }
                  }
                }
              },
              "if": {
                "properties": {
                  "adapter": {
                    "const": "json-api"
                  }
                },
                "required": [
                  "adapter"
                ]
              },
              "then": {
                "properties": {
                  "params": {
                    "additionalProperties": false,
                    "properties": {
                      "fields": {
                        "additionalProperties": {
                          "type": "string"
                        },
                        "type": "object"
                      },
                      "items_path": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "max_pages": {
                        "maximum": 20,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "next_path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "items_path",
                      "fields"
                    ],
                    "type": "object"
                  }
                }
              }
            },
            "if": {
              "properties": {
                "adapter": {
                  "const": "xml"
                }
              },
              "required": [
                "adapter"
              ]
            },
            "then": {
              "properties": {
                "params": {
                  "additionalProperties": false,
                  "properties": {
                    "fields": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "item_path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "namespaces": {
                      "additionalProperties": {
                        "type": "string"
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "item_path",
                    "fields"
                  ],
                  "type": "object"
                }
              }
            }
          },
          "if": {
            "properties": {
              "adapter": {
                "const": "sitemap"
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": false,
                "properties": {
                  "lastmod_since": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  "max_sitemaps": {
                    "maximum": 50,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "path_prefix": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "if": {
          "properties": {
            "adapter": {
              "const": "page"
            }
          },
          "required": [
            "adapter"
          ]
        },
        "then": {
          "properties": {
            "params": {
              "additionalProperties": false,
              "if": {
                "required": [
                  "title_selector"
                ]
              },
              "properties": {
                "date_format": {
                  "minLength": 1,
                  "type": "string"
                },
                "date_regex": {
                  "minLength": 1,
                  "type": "string"
                },
                "date_selector": {
                  "minLength": 1,
                  "type": "string"
                },
                "item_selector": {
                  "minLength": 1,
                  "type": "string"
                },
                "link_selector": {
                  "minLength": 1,
                  "type": "string"
                },
                "max_pages": {
                  "maximum": 20,
                  "minimum": 0,
                  "type": "integer"
                },
                "summary_selector": {
                  "minLength": 1,
                  "type": "string"
                },
                "title_selector": {
                  "minLength": 1,
                  "type": "string"
                },
                "version_signal": {
                  "enum": [
                    "etag",
                    "last-modified",
                    "heading-date",
                    "body-hash"
                  ]
                }
              },
              "then": {
                "required": [
                  "item_selector"
                ]
              },
              "type": "object"
            }
          }
        }
      },
      "if": {
        "properties": {
          "adapter": {
            "const": "feed"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "properties": {
        "adapter": {
          "description": "Adapter module name under feeder/adapters that reads this route.",
          "enum": [
            "feed",
            "page",
            "sitemap",
            "xml",
            "json-api",
            "urllist",
            "artifact"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "page",
            "rss",
            "atom",
            "rdf",
            "jsonfeed",
            "sitemap",
            "xml",
            "json-api",
            "urllist",
            "artifact"
          ],
          "type": "string"
        },
        "params": {
          "description": "Adapter parameters; the allowed keys depend on the adapter (see the per-adapter rules below). Public values only. A page route with no item_selector is a landing route the poller never parses.",
          "type": "object"
        },
        "url": {
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url",
        "adapter"
      ],
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "properties": {},
            "type": "object"
          }
        }
      },
      "type": "object"
    }
  },
  "$id": "https://github.com/flywifi/info-feed-seeds/schema/source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Manifest of one source, stored at sources/<id>/source.json. The id must equal the folder name; hub lint checks that because a schema cannot see the path.",
  "if": {
    "required": [
      "auth"
    ]
  },
  "properties": {
    "added": {
      "description": "Date the source was added, YYYY-MM-DD.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "auth": {
      "additionalProperties": false,
      "description": "Present only for credential-gated sources. Names a credential, never a value, person or company.",
      "properties": {
        "credential": {
          "pattern": "^[a-z][a-z0-9-]{2,40}$",
          "type": "string"
        }
      },
      "required": [
        "credential"
      ],
      "type": "object"
    },
    "authority": {
      "enum": [
        "primary",
        "secondary"
      ],
      "type": "string"
    },
    "classification_review": {
      "description": "pending until a person confirms authority and tier.",
      "enum": [
        "pending",
        "confirmed"
      ],
      "type": "string"
    },
    "discovered_from": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "seed",
            "opml",
            "crawl",
            "autodiscovery",
            "manual"
          ],
          "type": "string"
        },
        "ref": {
          "description": "Seed file path, OPML URL, crawl job id, or the page that linked the feed.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "date"
      ],
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "expected_update_period_days": {
      "description": "How often the publisher is expected to post; a source quiet for longer than this is flagged stale.",
      "minimum": 0,
      "type": "number"
    },
    "homepage": {
      "pattern": "^https?://",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "industries": {
      "description": "Optional industry ids from schema/categories.json (industries), each once.",
      "items": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "type": "string"
      },
      "type": "array"
    },
    "interval_days": {
      "description": "Minimum days between polls of this source.",
      "minimum": 0,
      "type": "number"
    },
    "label": {
      "minLength": 1,
      "type": "string"
    },
    "lists": {
      "description": "Named lists this source belongs to (for example a profile's source list).",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "publisher": {
      "minLength": 1,
      "type": "string"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1,
      "type": "array"
    },
    "runs_on": {
      "items": {
        "enum": [
          "actions",
          "local"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_category": {
      "description": "The source category: where this feed sits as a whole, a category id from schema/categories.json. hub categorize reports each item's own content category from its text.",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string"
    },
    "source_subcategory": {
      "description": "The source subcategory, under the source category in schema/categories.json.",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string"
    },
    "tier": {
      "enum": [
        "canonical",
        "news",
        "vendor"
      ],
      "type": "string"
    },
    "topics": {
      "description": "topic or topic/subtopic ids from schema/topics.json.",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "verified": {
      "description": "Date of the last real fetch that parsed at least one item, or null when never proven.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "added",
    "authority",
    "classification_review",
    "discovered_from",
    "enabled",
    "homepage",
    "id",
    "label",
    "publisher",
    "routes",
    "source_category",
    "source_subcategory",
    "tier",
    "topics",
    "verified"
  ],
  "then": {
    "description": "A credential-gated source runs only on the local machine.",
    "properties": {
      "runs_on": {
        "items": {
          "const": "local"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "runs_on"
    ]
  },
  "title": "Source manifest",
  "type": "object"
}
