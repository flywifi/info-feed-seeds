{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash", "Read", "Edit", "Write", "Glob", "Grep", "NotebookEdit", "WebFetch", "WebSearch", "Agent", "TodoWrite"],
    "deny": ["Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main:*)"]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "crossSessionInbound": "accept",
    "enabledPlugins": {
    "install-checkpoint@synced": false
  }
}
