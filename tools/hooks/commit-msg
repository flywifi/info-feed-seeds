#!/bin/sh
# info-feed-seeds commit-msg: blocks trailers, session links, footers, dashes and review records;
# prints advisory lines for wording, which never stop the commit.
. "$(dirname "$0")/_common.sh"
skip_if_bypassed commit-msg
find_python
exec $PY -I "$ROOT/tools/commit_check.py" --message-file "$1"
