#!/bin/sh
# info-feed-seeds pre-push: push URL, protected branches, every commit and file on the branch (the
# range CI checks), then a rehearsal of the CI checks job (tools/preflight.py).
. "$(dirname "$0")/_common.sh"
skip_if_bypassed pre-push
find_python
refs=$(cat)
printf '%s\n' "$refs" | $PY -I "$ROOT/tools/commit_check.py" --pre-push "$1" "$2" || exit 1
fast=""
[ "${IFS_PREFLIGHT_FAST:-}" = "1" ] && fast="--fast"
printf '%s\n' "$refs" | $PY -I "$ROOT/tools/preflight.py" --pre-push $fast
